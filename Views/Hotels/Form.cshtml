@model Hotel
@{
    ViewData["Title"] = Model.Id == 0 ? "Nuevo hotel" : "Editar hotel";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Save" method="post" class="col-lg-8">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label" asp-for="Name">Nombre</label>
        <input class="form-control" asp-for="Name" />
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="City">Ciudad</label>
            <input class="form-control" asp-for="City" />
            <span class="text-danger" asp-validation-for="City"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="Stars">Estrellas</label>
            <select class="form-select" asp-for="Stars" asp-items="@(new SelectList(Enumerable.Range(1, 5)))">
                <option value="">Sin calificar</option>
            </select>
            <span class="text-danger" asp-validation-for="Stars"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="AveragePrice">Precio medio (€)</label>
            <input class="form-control" asp-for="AveragePrice" type="number" min="0" max="10000" step="0.01" data-msg="El precio medio debe estar entre 0 y 10000, con 2 decimales como máximo."/>
            <span class="text-danger" asp-validation-for="AveragePrice"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="OpeningDate">Fecha de apertura</label>
            <input class="form-control" asp-for="OpeningDate" type="date" asp-format="{0:yyyy-MM-dd}" />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="HotelType">Tipo de hotel</label>
        <select class="form-select" asp-for="HotelType" asp-items="Html.GetEnumSelectList<HotelType>()">
            <option value="">Selecciona un tipo</option>
        </select>
    </div>

    <div class="form-check form-switch mb-3">
        <input class="form-check-input" asp-for="Active" />
        <label class="form-check-label" asp-for="Active">Activo</label>
    </div>

    <button class="btn btn-primary" type="submit">Guardar</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
