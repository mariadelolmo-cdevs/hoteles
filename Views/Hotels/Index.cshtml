@model List<Hotel>
@{
    ViewData["Title"] = "Hoteles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Hoteles</h1>
    <a class="btn btn-success" asp-action="Create">Nuevo hotel</a>
</div>

<p>Hay @Model.Count hoteles.</p>

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <label class="form-label" for="search">Nombre</label>
        <input class="form-control" id="search" name="search" value="@ViewBag.Search" placeholder="Buscar por nombre" />
    </div>

    <div class="cold-md-4">
        <label class="form-label" for="hotelType">Tipo de hotel</label>
        <select class="form-select" id="hotelType" name="hotelType">
            <option value="">Todos</option>
            @foreach (var type in Enum.GetValues<HotelType>())
                {
                    <option value="@type" selected="@(type == ViewBag.HotelType)">@Html.DisplayFor(m => type)</option>
                }
        </select>
    </div>

    <div class="col-md-3">
        <button class="btn btn-primary" type="submit">Filtrar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Ciudad</th>
            <th>Estrellas</th>
            <th>Tipo</th>
            <th>Precio medio</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hotel in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@hotel.Id">@hotel.Name</a></td>
                <td>@hotel.City</td>
                <td>@hotel.Stars</td>
                <td>@Html.DisplayFor(m => hotel.HotelType)</td>
                <td>@hotel.AveragePrice €</td>
                <td>@(hotel.Active ? "Sí" : "No")</td>
                <td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@hotel.Id">Editar</a></td>
            </tr>
        }
    </tbody>
</table>
